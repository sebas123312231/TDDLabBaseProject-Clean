{
  "name": "perdi-u",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "default": "index.html",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "preview": "pnpm --filter @perdiu/web preview",
    "dev": "pnpm test:build && pnpm --parallel --stream --filter @perdiu/api --filter @perdiu/web run dev",
    "dev:api": "pnpm test:build && pnpm --filter @perdiu/api dev",
    "dev:web": "pnpm --filter @perdiu/web dev",
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm test:build && node ./scripts/run-tdd.mjs",
    "test:build": "pnpm --recursive --if-present build",
    "test:runner": "node --test scripts/test/tdd-script.test.mjs",
    "cypress": "cypress open",
    "cypress-run": "cypress run",
    "lint": "eslint .",
    "auth:keys": "node scripts/auth-keys.mjs",
    "test:auth": "pnpm test:build && node scripts/verify-auth.mjs",
    "test:integration": "node scripts/verify-catalog.mjs",
    "test:e2e": "node scripts/verify-catalog.mjs --with-browser",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @perdiu/database... build && pnpm --filter @perdiu/database db:migrate",
    "db:seed": "pnpm --filter @perdiu/database... build && pnpm --filter @perdiu/database db:seed",
    "prepare": "husky",
    "semantic-commits-on": "node semantic-commits.js enable",
    "semantic-commits-off": "node semantic-commits.js disabled"
  },
  "author": "Israel Antezana R.",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.25.9",
    "babel-jest": "^29.7.0",
    "cross-spawn": "^7.0.3",
    "cypress": "^13.13.3",
    "eslint": "^9.10.0",
    "husky": "^9.1.6",
    "@jest/globals": "29.7.0",
    "jest": "^29.7.0",
    "parcel": "^2.12.0"
  },
  "dependencies": {}
}
