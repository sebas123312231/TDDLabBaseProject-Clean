# Local development only. URL-encode special characters in the DATABASE_URL password.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://perdiu:<url-encoded-password>@127.0.0.1:5433/perdiu_dev
PORT=3000
HOST=127.0.0.1

# Local Supabase Auth (GoTrue). Generate these values with `pnpm auth:keys`.
AUTH_DB_PASSWORD=
AUTH_JWT_SECRET=
AUTH_JWT_KEYS=
AUTH_SITE_URL=http://localhost:5173
AUTH_PUBLIC_URL=http://localhost:5173/auth
AUTH_REDIRECT_ALLOW_LIST=http://localhost:5173/**,http://127.0.0.1:5173/**
AUTH_MAILER_AUTOCONFIRM=false

# Public Auth verification settings used only by the API.
AUTH_JWKS_URL=http://127.0.0.1:9999/.well-known/jwks.json
AUTH_JWT_ISSUER=http://localhost:5173/auth
AUTH_JWT_AUDIENCE=authenticated
